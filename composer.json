{
    "name": "capell-app/widget-location-map",
    "description": "Privacy-gated OpenStreetMap location widget for Capell.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "capell-app/admin": "^1.0",
        "capell-app/core": "^1.0",
        "capell-app/frontend": "^1.0",
        "capell-app/layout-builder": "^1.0",
        "spatie/laravel-package-tools": "^0.0"
    },
    "autoload": {
        "psr-4": {
            "Capell\\WidgetLocationMap\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Capell\\WidgetLocationMap\\Providers\\WidgetLocationMapServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    },
    "prefer-stable": true
}
