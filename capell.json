{
    "manifest-version": 3,
    "name": "capell-app/widget-location-map",
    "slug": "widget-location-map",
    "displayName": "Location Map Widget",
    "kind": "package",
    "capellApiVersion": "^1.0",
    "version": "1.0.0",
    "description": "Validated latitude and longitude markers with ordinary links and explicit-activation OpenStreetMap embeds.",
    "product": {
        "group": "Capell Essentials",
        "tier": "free",
        "bundle": "foundation"
    },
    "namespace": "Capell\\WidgetLocationMap",
    "surfaces": ["admin", "frontend"],
    "dependencies": {
        "requires": [
            "capell-app/admin",
            "capell-app/core",
            "capell-app/frontend",
            "capell-app/layout-builder"
        ],
        "supports": ["capell-app/privacy-center"],
        "conflicts": []
    },
    "providers": {
        "metadata": [],
        "install": [],
        "runtime": [
            "Capell\\WidgetLocationMap\\Providers\\WidgetLocationMapServiceProvider"
        ],
        "admin": [],
        "frontend": []
    },
    "contributes": [
        {
            "type": "content-widget",
            "key": "capell-app.location-map",
            "class": "Capell\\WidgetLocationMap\\WidgetLocationMapContribution"
        },
        {
            "type": "asset",
            "key": "resource-group:capell-app.widget-location-map",
            "class": "Capell\\WidgetLocationMap\\WidgetLocationMapContribution"
        }
    ],
    "database": {
        "migrations": false,
        "settings": false,
        "requiredTables": []
    },
    "commands": {
        "install": null,
        "setup": null,
        "setupParams": [],
        "demo": null,
        "doctor": null
    },
    "settings": [],
    "permissions": [],
    "capabilities": ["frontend.public-static"],
    "security": {
        "riskTier": "low",
        "publicSurface": {
            "routeNames": [],
            "auth": "none",
            "csrfExemptRoutes": [],
            "signedRoutes": [],
            "tokenizedRoutes": [],
            "webhookRoutes": [],
            "throttledRoutes": []
        },
        "sensitiveData": {
            "encryptedFields": [],
            "hashedTokenFields": [],
            "redactedOutputClasses": [],
            "plaintextJustifications": []
        },
        "publicOutput": {
            "cacheSafe": true,
            "forbidAuthoringSurface": true,
            "forbidSecrets": true,
            "forbidPublicBladeQueries": true
        },
        "externalHttpClients": {
            "requiresTimeouts": false,
            "requiresSecretRedaction": false,
            "clients": []
        },
        "adminSurface": {
            "authorization": "panel-auth",
            "permissions": []
        }
    },
    "performance": {
        "frontendRenderBudgetMs": 8,
        "adminQueryBudget": 0,
        "cacheTags": ["widget-location-map"],
        "cacheSafety": {
            "cacheable": false,
            "variesBy": ["site", "locale", "theme"],
            "sensitiveOutput": false,
            "invalidationSources": [
                {
                    "model": "Capell\\Core\\Models\\Page",
                    "events": [
                        "created",
                        "updated",
                        "deleted",
                        "restored",
                        "forceDeleted"
                    ]
                }
            ],
            "queueInvalidation": false
        }
    },
    "healthChecks": [
        {
            "key": "widget-location-map.package-health",
            "label": "Location Map widget package health",
            "class": "Capell\\WidgetLocationMap\\Health\\WidgetLocationMapHealthCheck",
            "severity": "critical",
            "surface": "frontend"
        }
    ],
    "commercial": {
        "proposedLicense": "free",
        "requestedCertification": "first-party",
        "supportPolicy": "capell-first-party",
        "privateDocsRequested": false
    },
    "marketplace": {
        "summary": "Privacy-gated OpenStreetMap locations with useful no-JavaScript links.",
        "description": "Publish one to twenty offices, venues or service points with a plain list of addresses and OpenStreetMap links that work before any map loads. Requires Layout Builder. Limits: coordinates are entered by hand, and the interactive OpenStreetMap map loads only after the visitor chooses to activate it.",
        "problem": "Visitors looking for a location need directions without being forced to load an interactive map.",
        "outcome": "A page has location links with an optional visitor-activated map.",
        "faq": [
            {
                "question": "What appears before the map is activated?",
                "answer": "Visitors initially receive ordinary OpenStreetMap links for the configured places."
            },
            {
                "question": "Can privacy choices block the embed?",
                "answer": "The optional interactive embed can respect Privacy Centre decisions."
            },
            {
                "question": "How many locations can a map show?",
                "answer": "A map must have between 1 and 20 markers."
            }
        ],
        "screenshots": [
            {
                "path": "docs/assets/marketplace/listing-location-map-public-output.png",
                "alt": "Location Map public output",
                "caption": "Location Map public output"
            },
            {
                "path": "docs/assets/marketplace/listing-location-map-layout-builder-editor.png",
                "alt": "Location Map fields in Layout Builder",
                "caption": "Location Map fields in Layout Builder"
            },
            {
                "path": "docs/assets/marketplace/extension-card.jpg",
                "alt": "Location Map widget preview",
                "caption": "Location Map widget"
            }
        ],
        "categories": ["foundation", "frontend", "location"]
    }
}
